# Watsonx
WATSONX__APIKEY="your_ibm_cloud_api_key_here"
WATSONX__URL="https://us-south.ml.cloud.ibm.com"
WATSONX__PROJECT_ID="your_watsonx_project_id_here"

# Chroma
CHROMA__DB_PATH=./chroma_db
CHROMA__COLLECTION_NAME=documents

# Cache
CACHE__DIR=document_cache
CACHE__EXPIRE_DAYS=7

# Retrieval
RETRIEVAL__VECTOR_SEARCH_K=10
RETRIEVAL__HYBRID_RETRIEVER_WEIGHTS="[0.4, 0.6]"

# App
APP__MAX_FILE_SIZE=5242880
APP__MAX_TOTAL_SIZE=10485760
APP__ALLOWED_TYPES='["pdf","txt","docx"]'

# Logging
LOGGING__LEVEL=INFO